DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backend?schema=public"
PORT=3000

# Origens liberadas para o navegador, separadas por vírgula. Abaixo é o Expo web
# (`npm run web` no client-mobile). Vazio: libera tudo fora de produção, e em
# produção desliga o CORS.
CORS_ORIGINS=http://localhost:8081

# --- AWS local (MiniStack) — ver docs/ambiente-local.md e ADR-12 -------------
# O emulador não valida credenciais; qualquer valor serve. Em produção estas
# três variáveis somem: AWS_ENDPOINT_URL fica vazio (o SDK acha a AWS real
# sozinho) e as credenciais vêm da role da máquina, nunca de arquivo.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Porta publicada pelo MiniStack no host. Só mexa se a 4566 já estiver ocupada
# (e então ajuste o AWS_ENDPOINT_URL acima junto).
MINISTACK_PORT=4566

# Porta do IdP fake que faz o papel do Google e da Apple (ADR-13).
OIDC_MOCK_PORT=8090

# Endereços para onde o Cognito devolve o app após o login social. O padrão
# (no docker-compose.yml) cobre o scheme do app, Expo Go no simulador e Expo
# web. Descomente para acrescentar o IP do seu celular e rode o bootstrap.
# COGNITO_CALLBACK_URLS=administranest://auth/callback,exp://127.0.0.1:8081/--/auth/callback,http://localhost:8081/auth/callback,exp://<ip>:8081/--/auth/callback

# ATENÇÃO: Caso tenha mudado o nome do bucket após a primeira inicialização,
# rode `npm run dev:bootstrap` de novo para criar o bucket novo.
S3_BUCKET=administranest-local

# COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID, COGNITO_JWKS_URI, COGNITO_ISSUER e COGNITO_OAUTH_URL
# NÃO ficam aqui: só existem depois que o `npm run dev:bootstrap` cria o pool.
# Ele os grava em .aws-local.env, que o ConfigModule carrega junto com este.
