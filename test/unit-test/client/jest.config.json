{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/unit-test/client/**/*.spec.ts",
    "<rootDir>/test/unit-test/client/**/*.e2e-spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!jose/)"],
  "testTimeout": 30000
}
