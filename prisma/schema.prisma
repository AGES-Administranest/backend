// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Translated from "Administranest -intermediaria.sql" (dbdiagram.io). The ///
// comments below come from the COMMENT ON statements of the original SQL — they
// document modeling decisions, but are not persisted in the database (Prisma
// does not support COMMENT ON natively).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClientType {
  INDIVIDUAL
  CLINIC

  @@map("client_type_enum")
}

enum TaxIdType {
  CPF
  CNPJ

  @@map("tax_id_type_enum")
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN

  @@map("weekday_enum")
}

enum PaymentMethod {
  CARD
  BANK_SLIP
  PIX
  OTHER

  @@map("payment_method_enum")
}

enum Species {
  CANINE
  FELINE
  OTHER

  @@map("species_enum")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED

  @@map("appointment_status_enum")
}

enum EntryNature {
  INCOME
  EXPENSE

  @@map("entry_nature_enum")
}

enum EntryScope {
  PROFESSIONAL
  PERSONAL

  @@map("entry_scope_enum")
}

enum EntryStatus {
  PENDING
  SETTLED
  CANCELED

  @@map("entry_status_enum")
}

enum EntrySource {
  APPOINTMENT
  SERVICE_INVOICE
  PURCHASE_INVOICE
  TRIP
  MANUAL

  @@map("entry_source_enum")
}

/// Movement direction. Sign convention (see docs/data-dictionary.md):
/// quantity is ALWAYS positive; the sign in the balance calculation comes
/// exclusively from type — INBOUND adds, OUTBOUND subtracts. This applies to
/// every source, including MANUAL_ADJUSTMENT (an adjustment that increases stock
/// is INBOUND, one that decreases it is OUTBOUND) and CORRECTION_REVERSAL (type
/// opposite to that of the record being reversed).
enum StockMovementType {
  INBOUND
  OUTBOUND

  @@map("stock_movement_type_enum")
}

enum StockMovementSource {
  MANUAL_PURCHASE
  ORDER_IMPORT
  APPOINTMENT
  MANUAL_ADJUSTMENT
  CORRECTION_REVERSAL

  @@map("stock_movement_source_enum")
}

enum AdjustmentReason {
  LOSS
  EXPIRATION
  BREAKAGE
  OTHER

  @@map("adjustment_reason_enum")
}

enum PurchaseOrderStatus {
  DRAFT
  PLACED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status_enum")
}

enum ReportStatus {
  PENDING
  DONE
  FAILED

  @@map("report_status_enum")
}

enum MeasurementUnit {
  UNIT
  AMPOULE
  VIAL
  BOX
  ML
  MG
  GRAM
  TABLET
  OTHER

  @@map("measurement_unit_enum")
}

/// Identity and owner of all data. No admin role: the system is for individual
/// use by the professional, with no confirmed need for multi-user support.
model User {
  id         String     @id @default(uuid()) @db.Uuid
  cognitoSub String     @unique @map("cognito_sub")
  email      String     @unique
  name       String
  crmv       String?
  /// CPF or CNPJ — appears on the invoices the professional receives
  taxId      String?    @map("tax_id")
  taxIdType  TaxIdType? @map("tax_id_type")
  birthDate  DateTime?  @map("birth_date") @db.Date
  photoUrl   String?    @map("photo_url")

  termsAcceptedAt   DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  privacyAcceptedAt DateTime? @map("privacy_accepted_at") @db.Timestamptz(6)
  termsVersion      String?   @map("terms_version")

  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  clients             Client[]
  appointments        Appointment[]
  trips               Trip[]
  suppliers           Supplier[]
  items               Item[]
  stockMovements      StockMovement[]
  equipments          Equipment[]
  serviceInvoices     ServiceInvoice[]
  purchaseOrders      PurchaseOrder[]
  purchaseInvoices    PurchaseInvoice[]
  financialCategories FinancialCategory[]
  financialEntries    FinancialEntry[]
  pricingSettings     PricingSettings?
  reports             Report[]

  @@map("user")
}

/// Who pays, not necessarily who is treated. CLINIC in most cases, INDIVIDUAL
/// when billed directly to the animal's owner.
model Client {
  id                     String         @id @default(uuid()) @db.Uuid
  userId                 String         @map("user_id") @db.Uuid
  type                   ClientType
  name                   String
  taxId                  String?        @map("tax_id")
  taxIdType              TaxIdType?     @map("tax_id_type")
  /// contact person — the clinic's veterinarian, when type=CLINIC
  contactName            String?        @map("contact_name")
  email                  String?
  phone                  String?
  addressLine            String?        @map("address_line")
  city                   String?
  state                  String?
  /// days of the week the professional works at this clinic
  serviceDays            Weekday[]      @map("service_days")
  /// estimated number of days until payment is received
  paymentTermsDays       Int?           @map("payment_terms_days")
  preferredPaymentMethod PaymentMethod? @map("preferred_payment_method")
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id])
  appointments    Appointment[]
  serviceInvoices ServiceInvoice[]

  @@index([userId, active])
  @@map("client")
}

/// Central entity. The patient is a snapshot in time, not an animal record.
/// Only starts_at is required, to allow a minimal entry. Billed = there is a
/// financial_entry with source=APPOINTMENT.
model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  clientId        String?           @map("client_id") @db.Uuid
  /// free text — no dedicated procedure catalog
  procedureName   String?           @map("procedure_name")
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?         @map("ends_at") @db.Timestamptz(6)
  /// when it differs from the client's address
  location        String?
  /// entered manually — no price table
  amount          Decimal?          @db.Decimal(14, 2)
  patientName     String?           @map("patient_name")
  /// free text; relevant when the billed client is the clinic, not the owner
  ownerName       String?           @map("owner_name")
  /// PENDING validation with the stakeholder — administrative or clinical data?
  species         Species?
  /// PENDING validation with the stakeholder — administrative or clinical data?
  patientAgeYears Int?              @map("patient_age_years")
  /// PENDING validation with the stakeholder — administrative or clinical data?
  weightKg        Decimal?          @map("weight_kg") @db.Decimal(6, 3)
  /// free-form administrative notes
  notes           String?
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  trips          Trip[]
  stockMovements StockMovement[]
  financialEntry FinancialEntry?

  @@index([userId, startsAt])
  @@index([userId, status, startsAt])
  @@index([userId, clientId])
  @@index([patientName])
  @@map("appointment")
}

/// No vehicle record and no cost split across multiple appointments: the cost
/// is recorded directly per trip.
model Trip {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  appointmentId String?   @map("appointment_id") @db.Uuid
  occurredOn    DateTime  @map("occurred_on") @db.Date
  distanceKm    Decimal?  @map("distance_km") @db.Decimal(10, 2)
  cost          Decimal?  @db.Decimal(14, 2)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  financialEntry FinancialEntry?

  @@index([userId, occurredOn])
  @@map("trip")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  name      String
  taxId     String?    @map("tax_id")
  taxIdType TaxIdType? @map("tax_id_type")
  contact   String?
  email     String?
  phone     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id])
  items            Item[]
  equipments       Equipment[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  stockMovements   StockMovement[]

  @@index([userId, active])
  @@map("supplier")
}

model Item {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  /// preferred/default supplier
  supplierId      String?         @map("supplier_id") @db.Uuid
  category        ItemCategory
  unit            MeasurementUnit
  name            String
  /// suggested cost for a new lot
  defaultUnitCost Decimal?        @map("default_unit_cost") @db.Decimal(14, 4)
  minimumStock    Decimal?        @map("minimum_stock") @db.Decimal(14, 3)
  /// CACHE derived from stock_movement (sum of movements, sign from type).
  currentQuantity Decimal         @default(0) @map("current_quantity") @db.Decimal(14, 3)
  /// US10: flags that the item needs a manual stock adjustment. Turned on when
  /// a movement (typically a CORRECTION_REVERSAL) leaves currentQuantity < 0;
  /// turned off when the user records the adjustment that reconciles the balance.
  /// Persisted because it is user workflow state, not a pure derivative of the
  /// balance (the item stays "to be adjusted" even after another inbound brings
  /// the negative back to zero).
  needsAdjustment Boolean         @default(false) @map("needs_adjustment")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)

  user                 User                  @relation(fields: [userId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  lots                 ItemLot[]
  stockMovements       StockMovement[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@index([userId, name])
  @@index([userId, active])
  @@index([userId, needsAdjustment])
  @@map("item")
}

/// Kept: the only way to know which batch is expiring. No user_id — inherited
/// through item_id.
model ItemLot {
  id              String    @id @default(uuid()) @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  lotNumber       String?   @map("lot_number")
  expirationDate  DateTime? @map("expiration_date") @db.Date
  /// actual cost of this lot — basis for the margin calculation
  unitCost        Decimal   @map("unit_cost") @db.Decimal(14, 4)
  /// CACHE
  currentQuantity Decimal   @default(0) @map("current_quantity") @db.Decimal(14, 3)
  receivedOn      DateTime  @map("received_on") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  item                 Item                  @relation(fields: [itemId], references: [id])
  stockMovements       StockMovement[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@index([itemId, expirationDate])
  @@map("item_lot")
}

/// Kept: provides history and traceability for stock.
/// Append-only: records are never edited — hence only createdAt, no updatedAt.
/// Correction contract:
///   - CORRECTION_REVERSAL: used when the wrong movement already affected the
///     balance and/or was already seen by the user. A new movement with the
///     opposite sign (same item/lot/quantity) is created to cancel the effect,
///     preserving history. The original movement keeps deletedAt = null.
///   - deletedAt (soft delete): used only for an error caught before any
///     relevant effect (e.g. an entry created and undone in the same operation,
///     with no report/query in between). Does not generate a reversal movement.
/// Rule: never both on the same record. Choose by state, not by preference.
/// Does NOT generate a financial_entry: the money already left at purchase time.
model StockMovement {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  itemId                String              @map("item_id") @db.Uuid
  lotId                 String?             @map("lot_id") @db.Uuid
  type                  StockMovementType
  source                StockMovementSource
  /// filled in only when source = MANUAL_ADJUSTMENT: reason for the adjustment.
  /// Answers the "why", never the direction — the direction always comes from type.
  adjustmentReason      AdjustmentReason?   @map("adjustment_reason")
  /// ALWAYS positive (never 0, never negative). The sign in the balance
  /// calculation comes exclusively from type. See docs/data-dictionary.md.
  quantity              Decimal             @db.Decimal(14, 3)
  /// snapshot of the lot cost at the time of the movement
  unitCost              Decimal             @map("unit_cost") @db.Decimal(14, 4)
  occurredAt            DateTime            @map("occurred_at") @db.Timestamptz(6)
  /// source APPOINTMENT: consumption during the appointment
  appointmentId         String?             @map("appointment_id") @db.Uuid
  /// source ORDER_IMPORT: inbound generated when receiving a purchase order
  purchaseOrderId       String?             @map("purchase_order_id") @db.Uuid
  /// source when the inbound came from an invoice line (OCR)
  purchaseInvoiceLineId String?             @map("purchase_invoice_line_id") @db.Uuid
  /// supplier of the inbound when there is no purchase invoice (e.g. source = MANUAL_PURCHASE)
  supplierId            String?             @map("supplier_id") @db.Uuid
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt             DateTime?           @map("deleted_at") @db.Timestamptz(6)

  user                User                 @relation(fields: [userId], references: [id])
  item                Item                 @relation(fields: [itemId], references: [id])
  lot                 ItemLot?             @relation(fields: [lotId], references: [id])
  appointment         Appointment?         @relation(fields: [appointmentId], references: [id])
  purchaseOrder       PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  purchaseInvoiceLine PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id])
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])

  @@index([userId, occurredAt])
  @@index([itemId, occurredAt])
  @@index([appointmentId])
  @@index([purchaseOrderId])
  @@index([purchaseInvoiceLineId])
  @@index([lotId])
  @@index([supplierId])
  @@index([userId, type])
  @@map("stock_movement")
}

/// Depreciation is NOT stored — it is calculated on demand in reports.
model Equipment {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  supplierId      String?   @map("supplier_id") @db.Uuid
  name            String
  purchaseValue   Decimal   @map("purchase_value") @db.Decimal(14, 2)
  salvageValue    Decimal   @default(0) @map("salvage_value") @db.Decimal(14, 2)
  acquisitionDate DateTime  @map("acquisition_date") @db.Date
  usefulLifeYears Int       @map("useful_life_years")
  /// calibration, warranty
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([userId, active])
  @@map("equipment")
}

/// Revenue invoice issued OUTSIDE the app. The monthly billing report sums
/// amount by month, with no need for a grouping table linking to appointments.
model ServiceInvoice {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  clientId      String?   @map("client_id") @db.Uuid
  number        String?
  issueDate     DateTime? @map("issue_date") @db.Date
  amount        Decimal?  @db.Decimal(14, 2)
  description   String?
  /// storage URL — PDF or photo
  fileUrl       String    @map("file_url")
  fileMimeType  String?   @map("file_mime_type")
  /// ensures idempotency on reprocessing
  fileHash      String?   @unique @map("file_hash")
  /// raw OCR output — used when extraction partially fails
  rawExtraction Json?     @map("raw_extraction")
  /// NULL = data still exactly as it came out of the OCR, not reviewed
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  financialEntry FinancialEntry?

  @@index([userId, issueDate])
  @@index([userId, number])
  @@map("service_invoice")
}

/// Purchase order placed with a supplier. When received (status = RECEIVED) it
/// generates the corresponding stock inbounds (stock_movement.source = ORDER_IMPORT).
/// Distinct from purchase_invoice, which is the fiscal document digitized via OCR.
model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  supplierId   String?             @map("supplier_id") @db.Uuid
  number       String?
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime?           @map("order_date") @db.Date
  expectedDate DateTime?           @map("expected_date") @db.Date
  receivedAt   DateTime?           @map("received_at") @db.Timestamptz(6)
  totalAmount  Decimal?            @map("total_amount") @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?           @map("deleted_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  stockMovements StockMovement[]

  @@index([userId, status])
  @@index([supplierId])
  @@map("purchase_order")
}

model PurchaseInvoice {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  supplierId    String?   @map("supplier_id") @db.Uuid
  number        String?
  issueDate     DateTime? @map("issue_date") @db.Date
  totalAmount   Decimal?  @map("total_amount") @db.Decimal(14, 2)
  /// storage URL — PDF or photo
  fileUrl       String    @map("file_url")
  fileMimeType  String?   @map("file_mime_type")
  fileHash      String?   @unique @map("file_hash")
  rawExtraction Json?     @map("raw_extraction")
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user           User                  @relation(fields: [userId], references: [id])
  supplier       Supplier?             @relation(fields: [supplierId], references: [id])
  lines          PurchaseInvoiceLine[]
  financialEntry FinancialEntry?

  @@index([userId, issueDate])
  @@map("purchase_invoice")
}

/// item_id is optional: the OCR may return a line that does not match any
/// registered item.
model PurchaseInvoiceLine {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseInvoiceId String  @map("purchase_invoice_id") @db.Uuid
  itemId            String? @map("item_id") @db.Uuid
  /// the lot created by this purchase
  lotId             String? @map("lot_id") @db.Uuid
  /// text exactly as it came on the invoice, even without a match to a
  /// registered item
  description       String
  quantity          Decimal @db.Decimal(14, 3)
  unitCost          Decimal @map("unit_cost") @db.Decimal(14, 4)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  item            Item?           @relation(fields: [itemId], references: [id])
  lot             ItemLot?        @relation(fields: [lotId], references: [id])
  stockMovements  StockMovement[]

  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_line")
}

/// Kept as a table (not an enum): allows custom categories beyond the system
/// defaults — real value even though it is not written in the Terms.
model FinancialCategory {
  id           String      @id @default(uuid()) @db.Uuid
  /// NULL = system default category
  userId       String?     @map("user_id") @db.Uuid
  name         String
  nature       EntryNature
  /// only fills in the entry's default
  defaultScope EntryScope  @map("default_scope")
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User?            @relation(fields: [userId], references: [id])
  entries FinancialEntry[]

  @@unique([userId, name])
  @@map("financial_category")
}

/// Single cash book. Cash view = filter by settlement_date. Accrual view =
/// accrual_date. Receivables/payables = status PENDING. Equipment depreciation
/// is deliberately NOT recorded here — it is calculated in reports. Recurring
/// entries (rent, etc.) are created manually every month.
model FinancialEntry {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  nature            EntryNature
  /// defaults from the category, editable per entry
  scope             EntryScope
  categoryId        String      @map("category_id") @db.Uuid
  description       String
  /// always positive — the sign comes from nature
  amount            Decimal     @db.Decimal(14, 2)
  /// when the fact occurred (accrual basis)
  accrualDate       DateTime    @map("accrual_date") @db.Timestamptz(6)
  /// forecast; derived from client.payment_terms_days when applicable
  dueDate           DateTime?   @map("due_date") @db.Date
  /// when the money actually changed hands. NULL = still open
  settlementDate    DateTime?   @map("settlement_date") @db.Date
  status            EntryStatus @default(PENDING)
  source            EntrySource
  appointmentId     String?     @unique @map("appointment_id") @db.Uuid
  serviceInvoiceId  String?     @unique @map("service_invoice_id") @db.Uuid
  purchaseInvoiceId String?     @unique @map("purchase_invoice_id") @db.Uuid
  tripId            String?     @unique @map("trip_id") @db.Uuid
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)

  user            User              @relation(fields: [userId], references: [id])
  category        FinancialCategory @relation(fields: [categoryId], references: [id])
  appointment     Appointment?      @relation(fields: [appointmentId], references: [id])
  serviceInvoice  ServiceInvoice?   @relation(fields: [serviceInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice?  @relation(fields: [purchaseInvoiceId], references: [id])
  trip            Trip?             @relation(fields: [tripId], references: [id])

  @@index([userId, settlementDate])
  @@index([userId, accrualDate])
  @@index([userId, status, dueDate])
  @@index([userId, scope, accrualDate])
  @@index([userId, categoryId])
  @@map("financial_entry")
}

/// Billable-hour calculator. Fixed costs and depreciation are calculated, not
/// stored here.
model PricingSettings {
  userId               String   @id @map("user_id") @db.Uuid
  /// monthly income goal — covers the owner's draw + margin concept from the
  /// requirements gathering
  monthlyIncomeGoal    Decimal? @map("monthly_income_goal") @db.Decimal(14, 2)
  weeklyHours          Decimal? @map("weekly_hours") @db.Decimal(6, 2)
  safetyMarginPct      Decimal? @map("safety_margin_pct") @db.Decimal(6, 2)
  transportCostMonthly Decimal? @map("transport_cost_monthly") @db.Decimal(14, 2)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("pricing_settings")
}

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  kind        String
  periodStart DateTime?    @map("period_start") @db.Date
  periodEnd   DateTime?    @map("period_end") @db.Date
  filters     Json?
  /// storage URL
  fileUrl     String?      @map("file_url")
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("report")
}
